{
  "name": "@hermes/study-desktop",
  "productName": "Hermes Study",
  "private": true,
  "version": "0.1.0",
  "description": "Desktop app for study-desktop: collect sources into Subjects, summarize, and chat over them.",
  "type": "module",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1 --port 5175",
    "dev:electron": "node scripts/build-electron.mjs && wait-on http://127.0.0.1:5175 && cross-env HERMES_STUDY_DEV_SERVER=http://127.0.0.1:5175 electron .",
    "build": "vite build && node scripts/build-electron.mjs",
    "typecheck": "tsc -p . --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "concurrently": "10.0.4",
    "cross-env": "10.1.0",
    "electron": "40.10.2",
    "esbuild": "0.28.1",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "wait-on": "9.0.10"
  }
}
